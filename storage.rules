// rules created with the help of ChatGPT, Model GPT-5
service firebase.storage {
  match /b/{bucket}/o {

    // Only allow authenticated users to read/write inside "uploads" folder
    match /uploads/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Optionally, block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
