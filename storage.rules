// rules created with the help of ChatGPT, Model GPT-5
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Diaries under pets
    match /owners/{ownerId}/pets/{petId}/diaries/{diaryId}/{filename} {
      allow read: if request.auth != null &&
                  (request.auth.uid == ownerId || request.auth.token.role == 'vet');
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }

    // 2. Pet Images
    match /owners/{ownerId}/pets/{petId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == ownerId || request.auth.token.role == 'vet');
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }
}
}