# Environment mode: local, prod (coming soon)
APP_ENV=local

# FULL Path to Google service account JSON
# Example Path for Linux/Mac OS: /home/user/Documents/project/backend/service-account-file.json
# Example Path for Windows: C:\Users\username\Documents\project\backend/service-account-file.json
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-admin.json