          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="Remove Owners From CSV" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">// Code generated using ChatGPT

// Folder and file setup
String folderPath = &quot;/Users/runavv/Documents/courses/se2/backend/profiling/data&quot;;
java.io.File folder = new java.io.File(folderPath);
if (!folder.exists()) {
    folder.mkdirs();
}

// CSV file reference
java.io.File file = new java.io.File(folderPath + &quot;/generated_owners.csv&quot;);

// Overwrite file with just the header (or leave completely empty)
java.io.FileWriter fw = new java.io.FileWriter(file, false); // false = overwrite
fw.write(&quot;email,password\n&quot;); // optional: write header
fw.close();

</stringProp>
