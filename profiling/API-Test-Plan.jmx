          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="Create Owners CSV" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">//Code generated from ChatGPT

// Fully-qualified paths
String folderPath = &quot;/Users/runavv/Documents/courses/se2/backend/profiling/data&quot;;
java.io.File folder = new java.io.File(folderPath);
if (!folder.exists()) {
    folder.mkdirs();
}

java.io.File file = new java.io.File(folderPath + &quot;/generated_owners.csv&quot;);

// Overwrite file only if it doesn&apos;t exist (start fresh per suite)
if (!file.exists()) {
    java.io.FileWriter fw = new java.io.FileWriter(file, false); // false = overwrite
    fw.write(&quot;email,password\n&quot;);
    fw.close();
}

// Generate unique user
long timestamp = System.currentTimeMillis() + Thread.currentThread().getId();
String email = &quot;owner&quot; + timestamp + &quot;@email.com&quot;;
String password = &quot;Pass123&quot;;

// Save for JMeter variables
vars.put(&quot;email&quot;, email);
vars.put(&quot;password&quot;, password);

// Append user to CSV (thread-safe using sync on file object)
synchronized(file) {
    java.io.FileWriter fw = new java.io.FileWriter(file, true); // true = append
    fw.write(email + &quot;,&quot; + password + &quot;\n&quot;);
    fw.close();
}
</stringProp>
